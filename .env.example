# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu-api-key-de-gemini

# Base de datos PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/smartchef
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Secreto JWT en Base64 (minimo 32 bytes). Genera el tuyo con:
#   openssl rand -base64 48
JWT_SECRET=

# Puerto (Render lo inyecta automaticamente)
PORT=8080
